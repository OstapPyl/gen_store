# Налаштування магазину (за замовчуванням: Gen)
STORE_NAME="Gen"
STORE_PHONE="+380 44 123 45 67"
STORE_EMAIL="info@gen-store.ua"
STORE_WORKING_HOURS="Пн-Сб: 09:00 - 19:00, Нд: 10:00 - 16:00"
STORE_PICKUP_ADDRESS="м. Київ, вул. Енергетиків, 10"

# База даних (PostgreSQL для продакшену, або залиште порожнім для локальної БД data/gen.db)
DATABASE_URL="postgresql://postgres:password@localhost:5432/gen_store"

# Секретні ключі безпеки
APP_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"
SYNC_API_TOKEN="replace-with-a-dedicated-random-read-only-sync-token"

# Нова пошта (серверний ключ API 2.0; якщо не вказано, діє безпечний режим ручного введення)
NOVA_POSHTA_API_KEY=""

# Постійне сховище завантажених файлів (зображення, PDF)
STORAGE_DIR="./public/uploads"

# Локальна утиліта синхронізації ноутбука
SYNC_SERVER_URL="http://localhost:3000"
SYNC_SQLITE_PATH="./orders.sqlite"
